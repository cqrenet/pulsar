# Top-level dependencies. requirements.txt is the hashed lock generated from this file; regenerate with:
#   docker run --rm -v "$PWD:/w" -w /w python:3.14-slim sh -c "pip install pip-tools && pip-compile --upgrade --generate-hashes --allow-unsafe --strip-extras requirements.in && pip-compile --upgrade --generate-hashes --allow-unsafe --strip-extras requirements-dev.in"
# Run it with the same Python minor version as backend/Dockerfile and the CI workflow: the lock is resolved for it.
# Dependabot keeps both files up to date.
fastapi
uvicorn[standard]
pymongo
python-dotenv
requests
PyYAML
PyJWT
cryptography
pydantic-settings
structlog
tenacity
prometheus-client
httpx
gunicorn
mcp
redis

# Optional: Azure Key Vault integration for secrets storage
# Uncomment if using AZURE_KEY_VAULT_NAME
