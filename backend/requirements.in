# Top-level dependencies. requirements.txt is the hashed lock generated from this file; regenerate with:
#   docker run --rm -v "$PWD:/w" -w /w python:3.11-slim sh -c "pip install pip-tools && pip-compile --generate-hashes --allow-unsafe --strip-extras requirements.in && pip-compile --generate-hashes --allow-unsafe --strip-extras requirements-dev.in"
# Dependabot keeps both files up to date.
fastapi
uvicorn[standard]
pymongo
python-dotenv
requests
PyYAML
PyJWT
cryptography
pydantic-settings
structlog
tenacity
prometheus-client
httpx
gunicorn
mcp<2  # 2.x renamed FastMCP and changed the SSE APIs: upgrade as its own change, not via a lock refresh
redis

# Optional: Azure Key Vault integration for secrets storage
# Uncomment if using AZURE_KEY_VAULT_NAME
# azure-identity
# azure-keyvault-secrets
